-- ESP Core Logic (Players)
local function removeESP(targetPlayer)
    if espObjects[targetPlayer] then
        if espObjects[targetPlayer].Highlight then
            espObjects[targetPlayer].Highlight:Destroy()
        end
        if espObjects[targetPlayer].Billboard then
            espObjects[targetPlayer].Billboard:Destroy()
        end
        espObjects[targetPlayer] = nil
    end
end

local function applyESP(targetPlayer)
    if targetPlayer == player then return end

    local character = targetPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        removeESP(targetPlayer)
        return
    end

    local role, color = getPlayerRole(targetPlayer)
    local shouldShowHighlight = espSettings[role]

    if not espObjects[targetPlayer] then
        espObjects[targetPlayer] = {}
    end

    local highlight = espObjects[targetPlayer].Highlight
    if highlight and highlight.Parent ~= character then
        highlight:Destroy()
        highlight = nil
        espObjects[targetPlayer].Highlight = nil
    end

    if shouldShowHighlight then
        if not highlight or not highlight.Parent then
            highlight = Instance.new("Highlight")
            highlight.Name = "JJMONHUB_ESP"
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            highlight.FillTransparency = 0.5
            highlight.OutlineTransparency = 0
            highlight.Parent = character
            espObjects[targetPlayer].Highlight = highlight
        end
        highlight.FillColor = color
        highlight.OutlineColor = color
        highlight.Enabled = true
    elseif highlight then
        highlight.Enabled = false
    end

    local billboard = espObjects[targetPlayer].Billboard
    if billboard and billboard.Parent and billboard.Parent.Parent ~= character then
        billboard:Destroy()
        billboard = nil
        espObjects[targetPlayer].Billboard = nil
    end

    if espSettings.Names and shouldShowHighlight then
        if not billboard or not billboard.Parent then
            billboard = Instance.new("BillboardGui")
            billboard.Name = "JJMONHUB_NameESP"
            billboard.AlwaysOnTop = true
            billboard.Size = UDim2.fromOffset(150, 30)
            billboard.StudsOffset = Vector3.new(0, 3, 0)

            local label = Instance.new("TextLabel")
            label.Name = "Title"
            label.Size = UDim2.fromScale(1, 1)
            label.BackgroundTransparency = 1
            label.Font = Enum.Font.GothamBold
            label.TextSize = 12
            label.TextStrokeTransparency = 0.2
            label.Parent = billboard

            billboard.Parent = character:FindFirstChild("Head") or character.HumanoidRootPart
            espObjects[targetPlayer].Billboard = billboard
        end

        local label = billboard:FindFirstChild("Title")
        if label then
            label.Text = targetPlayer.DisplayName .. "\n[" .. role .. "]"
            label.TextColor3 = color
        end
        billboard.Enabled = true
    elseif billboard then
        billboard.Enabled = false
    end
end

