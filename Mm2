-- Trolling Features
local function toggleSpinBot(state)
    if state then
        if spinConnection then spinConnection:Disconnect() end
        spinConnection = RunService.RenderStepped:Connect(function()
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                char.HumanoidRootPart.CFrame = char.HumanoidRootPart.CFrame * CFrame.Angles(0, math.rad(35), 0)
            end
        end)
    else
        if spinConnection then
            spinConnection:Disconnect()
            spinConnection = nil
        end
    end
end

local function toggleInvisible(state)
    local char = player.Character
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") or part:IsA("Decal") then
                part.Transparency = state and 1 or 0
            end
        end
    end
end

local function toggleChatSpam(state)
    if state then
        if spamConnection then task.cancel(spamConnection) end
        spamConnection = task.spawn(function()
            while trollSettings.ChatSpam do
                local message = "JJMONHUB MM2 Edition | Best Script Running!"
                pcall(function()
                    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
                        local channel = TextChatService.TextChannels.RBXGeneral
                        if channel then channel:SendAsync(message) end
                    else
                        ReplicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest:FireServer(message, "All")
                    end
                end)
                task.wait(6)
            end
        end)
    else
        if spamConnection then
            task.cancel(spamConnection)
            spamConnection = nil
        end
    end
end

-- Main Render/Stepped Loop
RunService.Stepped:Connect(function()
    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= player then
            applyESP(target)
        end
    end

    local char = player.Character
    local humanoid = char and char:FindFirstChildWhichIsA("Humanoid")
    if humanoid then
        if modSettings.WalkSpeedEnabled then
            humanoid.WalkSpeed = modSettings.WalkSpeedValue
        end
        if modSettings.JumpPowerEnabled then
            humanoid.JumpPower = modSettings.JumpPowerValue
        end
    end

    if modSettings.Noclip and char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end

    if modSettings.FOVEnabled then
        Workspace.CurrentCamera.FieldOfView = modSettings.FOVValue
    end
end)

