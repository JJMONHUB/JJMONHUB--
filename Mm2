-- Interactive Custom Slider Component
local function sliderRow(label, minVal, maxVal, currentVal, callback)
    local container = make("Frame", {
        Size = UDim2.new(1, 0, 0, 50),
        BackgroundColor3 = PANEL,
        BackgroundTransparency = 0.2,
        BorderSizePixel = 0
    }, content)

    round(container, 14)
    stroke(container, LINE, 1)

    local titleLabel = make("TextLabel", {
        Position = UDim2.fromOffset(10, 6),
        Size = UDim2.new(1, -70, 0, 18),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = WHITE,
        Font = Enum.Font.GothamMedium,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left
    }, container)

    local valLabel = make("TextLabel", {
        Position = UDim2.new(1, -55, 0, 6),
        Size = UDim2.fromOffset(45, 18),
        BackgroundTransparency = 1,
        Text = tostring(math.floor(currentVal)),
        TextColor3 = WHITE,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right
    }, container)

    local track = make("Frame", {
        Position = UDim2.new(0, 10, 1, -18),
        Size = UDim2.new(1, -20, 0, 6),
        BackgroundColor3 = LINE,
        BorderSizePixel = 0
    }, container)
    round(track, 3)

    local percent = math.clamp((currentVal - minVal) / (maxVal - minVal), 0, 1)

    local fill = make("Frame", {
        Size = UDim2.new(percent, 0, 1, 0),
        BackgroundColor3 = WHITE,
        BorderSizePixel = 0
    }, track)
    round(fill, 3)

    local thumb = make("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(percent, 0, 0.5, 0),
        Size = UDim2.fromOffset(14, 14),
        BackgroundColor3 = WHITE,
        BorderSizePixel = 0
    }, track)
    circle(thumb)

    local isDragging = false

    local function updateValue(inputPos)
        local trackAbsPos = track.AbsolutePosition.X
        local trackAbsSize = track.AbsoluteSize.X
        local rawPercent = math.clamp((inputPos.X - trackAbsPos) / trackAbsSize, 0, 1)
        local newValue = math.floor(minVal + (rawPercent * (maxVal - minVal)))

        fill.Size = UDim2.new(rawPercent, 0, 1, 0)
        thumb.Position = UDim2.new(rawPercent, 0, 0.5, 0)
        valLabel.Text = tostring(newValue)

        if callback then callback(newValue) end
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = true
            updateValue(input.Position)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateValue(input.Position)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = false
        end
    end)
end

