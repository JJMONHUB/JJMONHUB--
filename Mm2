-- Helper: Get MM2 Role of Player
local function getPlayerRole(targetPlayer)
    if not targetPlayer then return "Innocent", COLOR_INNOCENT end

    local backpack = targetPlayer:FindFirstChild("Backpack")
    local character = targetPlayer.Character

    local function hasItem(itemName)
        if character and character:FindFirstChild(itemName) then return true end
        if backpack and backpack:FindFirstChild(itemName) then return true end
        return false
    end

    if hasItem("Knife") then
        return "Murderer", COLOR_MURDERER
    elseif hasItem("Gun") or hasItem("Revolver") then
        return "Sheriff", COLOR_SHERIFF
    else
        return "Innocent", COLOR_INNOCENT
    end
end

-- Helper: Find player by role
local function findPlayerByRole(roleName)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            local role, _ = getPlayerRole(p)
            if role == roleName then
                return p
            end
        end
    end
    return nil
end

-- Helper: Check if a position is in the Lobby / Obby Spawn Area
local function isInLobbyOrObby(targetRootPart)
    if not targetRootPart then return true end
    
    local pos = targetRootPart.Position
    
    -- Check height or specific lobby boundaries (MM2 Lobby is located high up or far away)
    local lobbyPart = Workspace:FindFirstChild("Lobby") or Workspace:FindFirstChild("LobbySpawn")
    if lobbyPart then
        local lobbyPos = lobbyPart:IsA("Model") and lobbyPart:GetPivot().Position or lobbyPart.Position
        if (pos - lobbyPos).Magnitude < 160 then
            return true
        end
    end

    -- Default fallback check for MM2 Lobby height/area elevation
    if pos.Y > 120 or pos.Y < -100 then
        return true
    end

    return false
end

-- Helper: Find dropped Gun anywhere in Workspace (Recursive Search)
local function findDroppedGun()
    local directDrop = Workspace:FindFirstChild("GunDrop") or Workspace:FindFirstChild("Gun")
    if directDrop then
        if directDrop:IsA("BasePart") then return directDrop end
        if directDrop:IsA("Model") or directDrop:IsA("Tool") then
            return directDrop.PrimaryPart or directDrop:FindFirstChild("Handle") or directDrop:FindFirstChildWhichIsA("BasePart")
        end
    end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if (obj.Name == "GunDrop" or obj.Name == "Gun") and not obj:IsDescendantOf(player.Character) then
            if obj:IsA("BasePart") then
                return obj
            elseif obj:IsA("Model") or obj:IsA("Tool") then
                local part = obj.PrimaryPart or obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart")
                if part then return part end
            end
        end
    end
    return nil
end

-- Teleport Utility
local function teleportTo(targetPart)
    local char = player.Character
    if char and char:FindFirstChild("HumanoidRootPart") and targetPart then
        local targetCFrame = targetPart:IsA("Model") and targetPart:GetPivot() or (targetPart:IsA("BasePart") and targetPart.CFrame)
        if targetCFrame then
            char.HumanoidRootPart.CFrame = targetCFrame + Vector3.new(0, 3, 0)
            return true
        end
    end
    return false
end

