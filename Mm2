-- Auto Kill Loop Thread (Ignores players in Lobby/Obby area)
task.spawn(function()
    while true do
        task.wait(0.3)
        if combatSettings.AutoKill then
            local myRole, _ = getPlayerRole(player)
            
            if myRole == "Murderer" then
                local char = player.Character
                local backpack = player.Backpack
                
                if char and backpack then
                    local knife = char:FindFirstChild("Knife") or backpack:FindFirstChild("Knife")
                    if knife and knife.Parent == backpack then
                        local humanoid = char:FindFirstChildWhichIsA("Humanoid")
                        if humanoid then humanoid:EquipTool(knife) end
                    end
                end

                for _, target in ipairs(Players:GetPlayers()) do
                    if target ~= player and combatSettings.AutoKill then
                        local tChar = target.Character
                        local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                        local tHumanoid = tChar and tChar:FindFirstChildWhichIsA("Humanoid")
                        
                        -- Verification: Must be alive and NOT in the lobby/obby
                        if tRoot and tHumanoid and tHumanoid.Health > 0 and not isInLobbyOrObby(tRoot) then
                            local tRole, _ = getPlayerRole(target)
                            if tRole ~= "Murderer" then
                                teleportTo(tRoot)
                                task.wait(0.1)
                            end
                        end
                    end
                end
            end
        end
    end
end)

